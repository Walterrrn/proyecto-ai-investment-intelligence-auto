# ==============================================================================
# AI INVESTMENT INTELLIGENCE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# System Mode: 'development', 'staging', 'production'
ENVIRONMENT=development

# Autonomy Level Mode:
# 'ANALYST_ONLY' (Stage 1: Read-only, simulation, zero live orders)
# 'PAPER_TRADING' (Stage 2: Simulated orders with virtual broker)
# 'SUPERVISED' (Stage 3: Orders generated, explicit 2FA human approval required)
# 'LIMITED_AUTONOMY' (Stage 4: Automated execution under hard risk limits)
AUTONOMY_MODE=ANALYST_ONLY

# Security & API
PROJECT_NAME="AI Investment Intelligence"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32_chars_min
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Capital & Initial Scenario (EUR)
INITIAL_CAPITAL_EUR=20000.00
ALLOCATION_LONG_TERM_PCT=0.50
ALLOCATION_TACTICAL_PCT=0.15
ALLOCATION_CRYPTO_PCT=0.10
ALLOCATION_LIQUIDITY_PCT=0.25

# Sovereign Risk Engine Limits (Hard-coded safety defaults)
RISK_MAX_PER_TRADE_PCT=0.0050     # 0.50% max risk per trade
RISK_MAX_AGGREGATE_PCT=0.0150     # 1.50% max aggregate open risk
RISK_MAX_DAILY_LOSS_PCT=0.0100    # 1.00% max daily loss
RISK_MAX_WEEKLY_LOSS_PCT=0.0200   # 2.00% max weekly loss
RISK_DRAWDOWN_REVIEW_PCT=0.0800   # 8.00% review drawdown
RISK_DRAWDOWN_HALT_PCT=0.1000     # 10.00% hard stop drawdown
LEVERAGE_ALLOWED=false            # Absolutely no leverage in Phase 1

# Database Configuration (PostgreSQL 16 / TimescaleDB)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=investment_intelligence
# Async Database URL (default local for Docker Compose: postgresql+asyncpg://...)
# If using SQLite for lightweight local unit tests without Docker: sqlite+aiosqlite:///./test.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investment_intelligence

# Redis Cache & Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Market Data API Keys (Optional in Phase 1, required in Phase 2)
FRED_API_KEY=
FMP_API_KEY=

# Broker API Configurations (NOT USED IN PHASE 1 - PLACEHOLDERS ONLY)
# Never commit real credentials to Git!
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
